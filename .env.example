# ─────────────────────────────────────────────────────────────────────────────
# Clinic Next.js App — Environment Variables Template
# Copy to `.env` for local development or configure in Coolify Environment Vars.
# NEVER commit `.env` with real secrets.
# ─────────────────────────────────────────────────────────────────────────────

# ── Build-time + Runtime (in Coolify: check "Available at Buildtime") ────────
# No trailing slash on NEXT_PUBLIC_SITE_URL.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
NEXT_PUBLIC_SITE_URL=https://rkkbqnzxzkhmn4gof16rwwbn.79.72.6.5.sslip.io
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# ── Runtime Only (Server-side secrets) ───────────────────────────────────────
# Coolify: Expose port 4000, Healthcheck path /api/health
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres
PG_POOL_MAX=10
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ── Optional Integrations (Email / WhatsApp) ─────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=
WAHA_BASE_URL=
WAHA_API_KEY=
WAHA_SESSION=default
